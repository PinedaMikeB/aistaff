DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_inbox_sales_assistant?schema=public"
APP_PORT=3000
APP_URL="http://localhost:3000"
CHECKOUT_SUCCESS_URL="http://localhost:3000/checkout/success"
CHECKOUT_CANCEL_URL="http://localhost:3000/checkout/failure"
PAYMENT_MODE=test

XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

BUSINESS_BRAND_NAME="AIStaff"
BUSINESS_LEGAL_NAME="AIStaff Solutions Corporation"
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_REGISTERED_ADDRESS=
SUPPORT_EMAIL="support@aistaff.click"
SUPPORT_MOBILE="+63 900 000 0000"
BUSINESS_HOURS="Monday to Friday, 9:00 AM to 6:00 PM Philippine Time"

MANUAL_BANK_NAME=
MANUAL_BANK_ACCOUNT_NAME=
MANUAL_BANK_ACCOUNT_NUMBER=
MANUAL_BANK_SWIFT=
APP_BASE_URL="http://localhost:3000"
# Persistent public URL (Cloudflare Tunnel or deployed domain).
# Example: APP_PUBLIC_URL="https://aistaff-api.marga.biz"
APP_PUBLIC_URL=""

JWT_SECRET="replace-with-a-long-random-secret"
ENCRYPTION_SECRET="replace-with-32-plus-random-characters"

# Seed admin
SEED_ADMIN_EMAIL="admin@aistaff.click"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# AI provider: openai, gemini, or mock
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Public Closer demo guardrails. These are intentionally generous so owners can
# test repeatedly while still protecting the public endpoint from automated abuse.
DEMO_START_RATE_LIMIT_MAX=120
DEMO_CHAT_RATE_LIMIT_MAX=120
DEMO_MAX_MESSAGES_PER_SESSION=300

# Brandee (Business Analysis / Creative Planning Engine) — optional overrides.
# Leave unset to reuse AI_PROVIDER/OPENAI_MODEL/GEMINI_MODEL above. Only set
# these if Brandee's extraction or planning should use a different
# provider/model than the rest of the app (e.g. a cheaper model for
# extraction, a specific model confirmed available on this account for
# planning). Never guess a model name here — use one you've confirmed is
# actually enabled for OPENAI_API_KEY/GEMINI_API_KEY.
BRANDEE_EXTRACTION_PROVIDER=""
BRANDEE_EXTRACTION_MODEL=""
BRANDEE_PLANNER_PROVIDER=""
BRANDEE_PLANNER_MODEL=""
# If the primary planner model call fails, retry once with this model before
# falling back to the deterministic (non-AI) plan. Optional.
BRANDEE_PLANNER_FALLBACK_MODEL=""

# Meta Messenger
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN="aistaff_verify_2026"
META_PAGE_ID=""
META_PAGE_ACCESS_TOKEN=""

# --- Pitch (AI Voice Agent) -------------------------------------------------
# Pitch runs as its own process: `npm run pitch`. It never starts unless
# PITCH_ENABLED=true, so it cannot affect Closer or Brandee.
PITCH_ENABLED=false
# Switch between:
# - gemini: native Gemini Live audio in/out, safest fallback for production
# - local: whisper.cpp/VAD -> Gemini text -> local VoxCPM2 TTS
# - openai: OpenAI Realtime legacy path
PITCH_BRAIN_PROVIDER=gemini

# AIO100 gateway acting as SIP server. wan_default profile = port 5080.
PITCH_SIP_GATEWAY_HOST=192.168.100.200
PITCH_SIP_GATEWAY_PORT=5080
PITCH_SIP_USERNAME=8001
PITCH_SIP_PASSWORD=
# THIS MACHINE's LAN IP as the gateway sees it. Never 127.0.0.1 — the
# gateway sends RTP to this address.
PITCH_SIP_LOCAL_HOST=192.168.100.72
PITCH_SIP_LOCAL_PORT=5062
PITCH_SIP_REGISTER_EXPIRES=300

PITCH_RTP_PORT_START=40000
PITCH_RTP_PORT_END=40100

# One VoLTE module is assumed to be one cellular channel until tested.
PITCH_MAX_CONCURRENT_CALLS=1
PITCH_MAX_CALL_MS=600000

PITCH_REALTIME_MODEL=gpt-realtime
PITCH_VOICE=marin
PITCH_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
PITCH_GEMINI_VOICE=Aoede
PITCH_GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Local pipeline. Uses separate local services; Gemini Live settings above are
# untouched. Requires GEMINI_API_KEY, whisper.cpp server, and VoxCPM2 server.
PITCH_LOCAL_WHISPER_URL=http://127.0.0.1:8080/inference
PITCH_LOCAL_WHISPER_MODEL=ggml-base
PITCH_LOCAL_GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
PITCH_VOXCPM2_URL=http://127.0.0.1:9880/tts
PITCH_VOXCPM2_VOICE=
PITCH_VOXCPM2_SAMPLE_RATE=24000
VOXCPM2_DEVICE=mps
PITCH_LOCAL_REQUEST_TIMEOUT_MS=20000
PITCH_LOCAL_TEMPERATURE=0.75
PITCH_LOCAL_MAX_OUTPUT_TOKENS=120
PITCH_LOCAL_HISTORY_TURNS=6
PITCH_LOCAL_LOG_METRICS=true
PITCH_LOCAL_VAD_THRESHOLD=650
PITCH_LOCAL_VAD_SILENCE_MS=700
PITCH_LOCAL_VAD_MIN_SPEECH_MS=260
PITCH_LOCAL_VAD_MAX_SPEECH_MS=12000

PITCH_BUSINESS_NAME=
PITCH_AGENT_NAME=Pitch
PITCH_LOG_LEVEL=info
