// ===========================================================================
// Brandee — Super Admin-managed creative templates (PART 9/15 of the
// template-admin task). Two parallel model families (static image templates
// vs UGC/video templates) rather than one polymorphic table, since their
// schemas genuinely diverge (overlaySchema vs storyboardSchema/sceneSchema).
//
// Versioning (PART 25): editing a PUBLISHED template does not mutate it.
// `version` + `parentTemplateId` let a new row link back to the template it
// supersedes; existing customer projects store the exact template `id` +
// `version` they used (in the JSON project store — see productAdProjectStore.js)
// so a later edit never silently changes an already-generated project. Only
// the newest ACTIVE version of a given `slug` is offered to new projects.
// ===========================================================================
model StaticAdTemplate {
  id                      String    @id @default(uuid())
  slug                    String
  name                    String
  description             String    @db.Text
  category                String
  frameworkKey            String?
  // PRODUCT | SERVICE | UNIVERSAL — which example this specific template
  // visual is (most frameworks were imported with one product-oriented and
  // one service-oriented real example; see templateImport.js).
  audienceType            String    @default("UNIVERSAL")
  // Short "best for X" customer-facing label (PART 4/7), distinct from the
  // longer `description`.
  idealFor                String?   @db.Text
  // Dominant colors sampled from the source asset at import time, hex
  // strings — used for personalized-thumbnail color hints (PART 8) and
  // Super Admin preview only, never as the sole indicator of anything.
  dominantColors          String[]  @default([])
  // SHA-256 of the original imported file's bytes — lets the importer
  // (scripts/brandee-import-static-templates.js) detect an already-imported
  // file on a safe rerun without depending on filename stability.
  sourceChecksum          String?
  // Original filename from the import source, kept for provenance/audit only
  // (never used at runtime, never exposed as a public asset path).
  importedFromFilename    String?
  previewImageUrl         String?
  thumbnailUrl            String?
  sourceAssetUrl          String?
  // Editable overlay areas (product image/logo/headline/price/CTA/etc.) as
  // normalized-coordinate bounding boxes — see overlaySchema shape documented
  // in src/brandee/templateSchemas.js. Validated with Zod before every write.
  overlaySchema           Json      @default("{}")
  requiredFieldsSchema    Json      @default("[]")
  optionalFieldsSchema    Json      @default("[]")
  proofRequirements       Json      @default("[]")
  // Art direction for the AI_GENERATED_LAYOUT render mode: describes the
  // LAYOUT and VISUAL STYLE this framework should produce (columns, badge,
  // palette, photography mood) — never the customer's actual copy, which
  // comes from their field answers at generation time. GPT-5.6 Sol merges
  // this with those answers into the final GPT Image 2 prompt (see
  // creativePlanner.composeImagePrompt). Null = this template stays on the
  // deterministic SVG compositor.
  imageGenPrompt          String?   @db.Text
  supportedAspectRatios   Json      @default("[]")
  defaultAspectRatio      String    @default("4:5")
  defaultLanguage         String    @default("english")
  renderMode              String    @default("COMPOSITE_TEMPLATE") // COMPOSITE_TEMPLATE | AI_GENERATED_LAYOUT
  tags                    String[]  @default([])
  sortOrder               Int       @default(0)
  status                  String    @default("DRAFT") // DRAFT | ACTIVE | INACTIVE | ARCHIVED
  isFeatured              Boolean   @default(false)
  isPremium               Boolean   @default(false)
  version                 Int       @default(1)
  parentTemplateId        String?
  publishedAt             DateTime?
  retiredAt               DateTime?
  createdByPlatformUserId String?
  updatedByPlatformUserId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  archivedAt              DateTime?

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([parentTemplateId])
  @@index([sourceChecksum])
  @@map("static_ad_templates")
}

model UgcTemplate {
  id                      String    @id @default(uuid())
  slug                    String
  name                    String
  description             String    @db.Text
  category                String
  previewPosterUrl        String?
  previewVideoUrl         String?
  sourceAssetUrl          String?
  storyboardSchema        Json      @default("{}")
  sceneSchema             Json      @default("[]")
  creatorRequirements     Json      @default("{}")
  voiceRequirements       Json      @default("{}")
  scriptSchema            Json      @default("{}")
  requiredFieldsSchema    Json      @default("[]")
  optionalFieldsSchema    Json      @default("[]")
  proofRequirements       Json      @default("[]")
  supportedDurations      Json      @default("[]")
  supportedAspectRatios   Json      @default("[]")
  supportedLanguages      Json      @default("[]")
  // Safe provider identifiers/config ONLY — never a secret/API key. Enforced
  // by templateAdmin.js's scrubProviderConfiguration() before every write.
  modelProvider           String?
  providerConfiguration   Json      @default("{}")
  tags                    String[]  @default([])
  sortOrder               Int       @default(0)
  status                  String    @default("DRAFT")
  isFeatured              Boolean   @default(false)
  isPremium               Boolean   @default(false)
  version                 Int       @default(1)
  parentTemplateId        String?
  publishedAt             DateTime?
  retiredAt               DateTime?
  createdByPlatformUserId String?
  updatedByPlatformUserId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  archivedAt              DateTime?

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([parentTemplateId])
  @@map("ugc_templates")
}

// Draft/publish pricing + tax-mode configuration a SUPERADMIN can edit
// through /superadmin/brandee/pricing (PART 4/20) WITHOUT a code deploy.
// The runtime app reads the newest `status: "published"` row; if none
// exists yet, it falls back to the code-level defaults in pricingConfig.js
// (see pricingOverride.js). Editing never mutates a published row in place
// — publishing a new draft archives the previous published row, so the
// change is itself auditable/reversible via history, not just via the
// separate AdminAuditLog entry already written on publish.
model BrandeePricingConfig {
  id                      String    @id @default(uuid())
  status                  String    @default("draft") // draft | published | archived
  taxMode                 String    @default("NON_VAT") // NON_VAT | VAT
  pricesAreTaxInclusive   Boolean   @default(true)
  vatRatePercent          Decimal   @default(12) @db.Decimal(5, 2)
  // Array of plan objects — same shape as pricingConfig.js's PLANS constant.
  plans                   Json
  publishedAt             DateTime?
  createdByPlatformUserId String?
  updatedByPlatformUserId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([status])
  @@map("brandee_pricing_configs")
}

// Entitlement ledger (PART 27) — IMAGE_FINAL / VIDEO_SECONDS only, never a
// generic "credits" number. Append-only event log (RESERVE/CONSUME/RELEASE/
// REFUND); the remaining balance for a billing period is always DERIVED by
// summing events, never stored as a single mutable counter, so a crashed
// request can never silently double-spend or lose an entitlement.
model BrandeeEntitlementEvent {
  id              String   @id @default(uuid())
  customer_id     String
  subscription_id String?
  unit            String // IMAGE_FINAL | VIDEO_SECONDS
  eventType       String // RESERVE | CONSUME | RELEASE | REFUND
  amount          Int
  // References a project in the JSON-file product-ad project store
  // (productAdProjectStore.js), not a Postgres FK — that store is
  // intentionally outside Postgres for this MVP (see its own header comment).
  projectId       String?
  // Unique per (idempotencyKey, eventType) rather than idempotencyKey alone:
  // a RESERVE and its later RELEASE/CONSUME settlement event intentionally
  // share the SAME idempotencyKey (so computeRemaining() in entitlements.js
  // can group them together and cancel a released reservation out of the
  // balance) — only a duplicate RESERVE (or duplicate RELEASE/CONSUME) of
  // the exact same event is actually meant to be rejected.
  idempotencyKey  String
  reason          String?
  createdAt       DateTime @default(now())
  customer        Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey, eventType])
  @@index([customer_id, unit])
  @@index([subscription_id])
  @@index([idempotencyKey])
  @@map("brandee_entitlement_events")
}

model ManualPaymentProof {
  id                    String   @id @default(uuid())
  order_id              String
  transaction_reference String
  payment_date          DateTime
  sender_name           String
  amount_sent           Decimal  @db.Decimal(12, 2)
  proof_file_url        String?
  status                String   @default("awaiting_verification")
  admin_notes           String?  @db.Text
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  order                 Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([status])
  @@map("manual_payment_proofs")
}

// Product-ad project (image/video flow) — was a lightweight JSON-file store
// (productAdProjectStore.js), explicitly documented in its own header as an
// MVP-only pattern ("no new Prisma model/migration needed for MVP volumes
// ... migrate to a real table if volume grows"). Migrated now because: (1)
// uploaded product images move to real files on disk (ProductAdImageAsset
// below) referenced by URL instead of embedded as base64 blobs, which
// needed real disk-backed rows anyway; (2) growing multi-customer volume
// made per-write full-file read/write with zero concurrent-write safety a
// real risk. BrandeeEntitlementEvent.projectId (above) is a loose string
// reference by design, not a Postgres FK — this model keeps `id` as a UUID
// string so those existing references keep resolving with no changes.
model ProductAdProject {
  id                  String   @id @default(uuid())
  kind                String // "image" | "video"
  anonymousSessionId  String?
  userId              String?
  product             Json     @default("{}")
  templateId          String?
  styleId             String?
  templateFields      Json     @default("{}")
  videoFields         Json     @default("{}")
  preview             Json?
  finalAsset          Json?
  creativePlan        Json?
  analysis            Json?
  suggestionDecisions Json     @default("{}")
  status              String   @default("draft")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  revisions ProductAdRevision[]
  images    ProductAdImageAsset[]

  @@index([anonymousSessionId])
  @@index([userId])
  @@index([status])
  @@map("product_ad_projects")
}

// Append-only revision history (unchanged semantics from the JSON store's
// addRevision/listRevisions/restoreRevision — nothing is ever overwritten
// or deleted, so the customer can always view/compare/restore an earlier
// version).
model ProductAdRevision {
  id             String   @id @default(uuid())
  projectId      String
  revisionNumber Int
  instruction    String?  @db.Text
  plan           Json?
  svg            String   @db.Text
  width          Int
  height         Int
  watermarked    Boolean  @default(true)
  aiUsed         Boolean  @default(false)
  createdAt      DateTime @default(now())

  project ProductAdProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, revisionNumber])
  @@index([projectId])
  @@map("product_ad_revisions")
}

// One uploaded customer image (product photo or logo) — a real file on
// disk (data/brandee-uploads/<scopeId>/<uuid>.<ext>, served at
// /uploads/brandee/<scopeId>/<uuid>.<ext>), never embedded as base64 here
// or in any generated SVG. `scopeId` (anonymousSessionId or userId) keeps
// each customer's uploads in their own directory.
model ProductAdImageAsset {
  id        String   @id @default(uuid())
  projectId String?
  scopeId   String
  role      String   @default("product") // "product" | "logo"
  url       String
  filePath  String
  mimeType  String
  bytes     Int
  width     Int?
  height    Int?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  project ProductAdProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([scopeId])
  @@map("product_ad_image_assets")
}

/// Password reset tokens.
///
/// The raw token is NEVER stored. Only sha256(token) is persisted, so a
/// database leak yields nothing usable — the same reasoning that applies to
/// password hashes. The raw value exists only in the email we send.
///
/// Single use, short lived, and all of a user's outstanding tokens are
/// invalidated when any one of them is redeemed.
model PasswordResetToken {
  id           String    @id @default(uuid())
  user_id      String
  /// sha256 hex of the raw token. Unique so redemption is a single indexed
  /// lookup rather than a scan — this is the hot path at scale.
  token_hash   String    @unique
  expires_at   DateTime
  used_at      DateTime?
  /// Recorded for abuse investigation, not for access decisions.
  requested_ip String?
  created_at   DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

/// A prospect trying Closer on their OWN business data, before buying.
///
/// Deliberately NOT a User or a Customer:
///   - the email is unverified, so anyone could type a competitor's address
///   - User.email is globally unique, so a demo row would BLOCK their real
///     signup later with a confusing "already registered"
///   - Customer is the billing record and must stay clean
///
/// `snapshot` is the scraped presence data from page-intelligence.js. Before
/// this table existed the scrape was formatted into a message body and thrown
/// away, so there was no way to review what the agent had learned, correct it,
/// or reuse it when the prospect bought. That reuse is exactly what the
/// setup fee covers.
model DemoSession {
  id              String    @id @default(uuid())
  name            String
  email           String
  /// E.164, normalised by src/phone.js. The ONLY number the demo will text —
  /// the model composes the message but never chooses the recipient.
  mobile_number   String?
  website_url     String?
  facebook_url    String?
  business_name   String?
  /// Structured output of buildPresenceSnapshot(). Facts only; the model
  /// writes every word it says (docs/handoff-masterplan.md).
  snapshot        Json?
  /// Plain text pulled from an uploaded price list (image, PDF, spreadsheet or
  /// doc). A Facebook Page can publish every price inside promo GRAPHICS,
  /// which Open Graph scraping cannot see — this is how those prices reach
  /// the agent. Facts only; the model writes its own words.
  price_list_text String?
  price_list_kind String?
  /// ISO code of the currency the scraped/uploaded prices are in. Without
  /// this the agent could read "$100" from a US store and quote it to a
  /// Filipino customer as if it were pesos.
  price_currency  String?
  price_list_name String?
  scrape_status   String    @default("pending")
  scrape_error    String?
  message_count   Int       @default(0)
  sms_sent        Int       @default(0)
  requested_ip    String?
  /// Retention limit. A stranger's business data and mobile number are
  /// personal data under the Data Privacy Act — purged, not kept forever.
  expires_at      DateTime
  converted_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([email])
  @@index([expires_at])
  @@index([created_at])
  @@map("demo_sessions")
}

/// One row per company per customer channel (Settings › Channels). Added 2026-10-20.
/// channel_key: facebook_messenger | email | website_chat | mobile_phone.
/// enabled = box ticked (unticking pauses; settings kept). ai_replies = Closer answers on this channel.
/// config = non-secret settings. secret_encrypted = channel password (src/crypto.js AES-GCM), never returned by the API.
/// tested_fingerprint = fingerprint of the settings that last passed "Test connection" (required before enabling).
model TenantChannel {
  id                 String    @id @default(uuid())
  company_id         String
  channel_key        String
  enabled            Boolean   @default(false)
  ai_replies         Boolean   @default(true)
  config             Json      @default("{}")
  secret_encrypted   String?
  tested_fingerprint String?
  last_tested_at     DateTime?
  last_ok_at         DateTime?
  last_error         String?
  last_error_at      DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  company            Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, channel_key])
  @@map("tenant_channels")
}

/// Every email the email channel read or sent: de-duplication (message_id), threading
/// (In-Reply-To / References) and loop protection. Skipped mail keeps its skip_reason.
model EmailMessageLog {
  id                String        @id @default(uuid())
  company_id        String
  conversation_id   String?
  direction         String
  message_id        String
  in_reply_to       String?
  references_header String?       @db.Text
  from_address      String?
  to_address        String?
  subject           String?
  skip_reason       String?
  imap_uid          Int?
  created_at        DateTime      @default(now())
  company           Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  conversation      Conversation? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)

  @@unique([company_id, message_id])
  @@index([conversation_id, created_at])
  @@index([company_id, to_address, created_at])
  @@map("email_message_log")
}

/// Staff resolve loop (added 2026-10-20): every button press or email reply on an
/// ACTION NEEDED / URGENT alert. action: retry | manual | handle. via: link | email.
/// outcome: done | still_failing | not_found | claimed | busy | already_done | unclear.
/// message_id (email replies) makes each reply act once.
model StaffResolveAction {
  id          String   @id @default(uuid())
  company_id  String
  request_id  String
  action      String
  actor_email String?
  via         String
  reference   String?
  outcome     String
  detail      String?  @db.Text
  message_id  String?  @unique
  created_at  DateTime @default(now())
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([request_id, created_at])
  @@map("staff_resolve_actions")
}

/// Saved contacts, kept ONLY with the customer's permission (src/contacts.js). Added 2026-10-20.
/// One row per company + channel identity (email address, Messenger PSID, chat id, phone number).
/// consent "yes" = reuse and greet by name; "no" = asked not to be remembered.
model ContactProfile {
  id              String    @id @default(uuid())
  company_id      String
  channel         String
  identity        String
  conversation_id String?
  name            String?
  address_as      String?
  phone           String?
  phone_key       String?
  email           String?
  organization    String?
  branch          String?
  department      String?
  details         Json      @default("{}")
  consent         String    @default("yes")
  consent_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  company         Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, channel, identity])
  @@index([company_id, phone_key])
  @@map("contact_profiles")
}

/// After-service follow-up per finished job (src/feedback.js, added 2026-10-20): "was it done?" right
/// after the job is closed/delivered, plus survey ratings for the topics due for this customer.
model CustomerFeedback {
  id              String    @id @default(uuid())
  company_id      String
  request_id      String    @unique
  conversation_id String?
  token_hash      String    @unique
  reference       String?
  customer_key    String?
  customer_name   String?
  customer_email  String?
  job_label       String?
  staff_name      String?
  staff_role      String?
  finished_at     String?
  topics          Json      @default("[]")
  sent_at         DateTime?
  send_error      String?
  answered_at     DateTime?
  done            String?
  answers         Json      @default("{}")
  alerted_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  company         Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id, customer_key])
  @@index([company_id, answered_at])
  @@map("customer_feedback")
}

/// A Pitch phone line: one VoLTE router (e.g. AIO100) with its SIM.
/// Added by AIStaff staff in Platform > Phone Lines, handed to a tenant with a
/// one-time setup code, claimed by the tenant in Settings > Channels > Mobile Phone.
/// auth_username is the key src/pitch/tenant.js resolves a call to a company by.
model SipDevice {
  id                      String    @id @default(uuid())
  company_id              String?
  model                   String    @default("AIO100-1V")
  /// "aistaff" = hosted and managed at AIStaff (default); "customer" = at the customer's site
  location                String    @default("aistaff")
  device_serial           String    @unique
  sim_number              String?
  carrier                 String?
  phone_number            String?
  gateway_host            String?
  gateway_port            Int?
  auth_username           String    @unique
  auth_password_encrypted String?
  status                  String    @default("in_stock")
  max_channels            Int       @default(1)
  setup_code              String?   @unique
  setup_code_expires_at   DateTime?
  assigned_at             DateTime?
  claimed_at              DateTime?
  last_check_at           DateTime?
  last_check_ok           Boolean?
  last_seen_at            DateTime?
  last_call_at            DateTime?
  last_call_from          String?
  last_call_seconds       Int?
  last_call_mode          String?
  notes                   String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  company                 Company?  @relation(fields: [company_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@map("sip_devices")
}

/// Email Engine (added 2026-10-22). Sends one email to many recipients (one message
/// per recipient), throttled, with unsubscribe. First block of the future Marketing engine.
/// Tenant settings: Settings › Email Engine. Platform limits: Platform › Email Engine.
model EmailEngineSetting {
  id                  String    @id @default(uuid())
  company_id          String    @unique
  /// "channel" = the tenant's Email channel inbox (Settings › Channels › Email); "mailbox" = a separate sending mailbox
  sender_mode         String    @default("channel")
  mailbox_config      Json      @default("{}")
  mailbox_secret      String?
  mailbox_tested_at   DateTime?
  mailbox_tested_hash String?
  reply_to            String?
  per_minute          Int       @default(10)
  /// Daily limit of the mailbox from the email plan (Hostinger Business Starter = 1000/day)
  mailbox_daily_limit Int       @default(1000)
  /// Kept free every day for Closer replies and customer status emails from the same inbox
  reserve_for_closer  Int       @default(200)
  footer_text         String?   @db.Text
  unsubscribe_label   String?
  test_address        String?
  /// Outreach (one-to-one prospecting) mailbox - must be on a different domain from the tenant main mail
  outreach_config      Json      @default("{}")
  outreach_secret      String?
  outreach_tested_hash String?
  outreach_tested_at   DateTime?
  outreach_poll        Json      @default("{}")
  outreach_last_error  String?
  outreach_footer      String?   @db.Text
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  company             Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("email_engine_settings")
}

model EmailContact {
  id           String   @id @default(uuid())
  company_id   String
  email        String
  name         String?
  organization String?
  lists        String[] @default([])
  source       String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  company      Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, email])
  @@index([company_id, created_at])
  @@map("email_contacts")
}

model EmailCampaign {
  id            String                   @id @default(uuid())
  company_id    String
  name          String
  subject       String
  body_text     String                   @db.Text
  /// draft | sending | paused | done | cancelled
  status        String                   @default("draft")
  pause_reason  String?
  from_address  String?
  total         Int                      @default(0)
  sent_count    Int                      @default(0)
  failed_count  Int                      @default(0)
  skipped_count Int                      @default(0)
  created_by    String?
  started_at    DateTime?
  finished_at   DateTime?
  last_error    String?
  last_error_at DateTime?
  alerted_at    DateTime?
  /// broadcast = same email to many; outreach = one-to-one, AI-drafted per company, with follow-ups
  kind           String    @default("broadcast")
  /// Pace: at most pace_count emails every pace_hours hours (null = no extra pace)
  pace_count     Int?
  pace_hours     Int?
  /// {"weekdays_only":true,"from":"08:00","to":"18:00"} in Asia/Manila; {} = any time
  send_window    Json      @default("{}")
  followups      Int       @default(0)
  followup_days  Int       @default(4)
  require_review Boolean   @default(true)
  brief          String?   @db.Text
  sender_person  Json      @default("{}")
  pia            Json      @default("{}")
  pia_done_at    DateTime?
  pia_by         String?
  last_sent_at   DateTime?
  created_at    DateTime                 @default(now())
  updated_at    DateTime                 @updatedAt
  company       Company                  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  recipients    EmailCampaignRecipient[]

  @@index([company_id, created_at])
  @@index([status])
  @@map("email_campaigns")
}

model EmailCampaignRecipient {
  id           String        @id @default(uuid())
  campaign_id  String
  company_id   String
  email        String
  name         String?
  /// pending | sending | sent | failed | skipped
  status       String        @default("pending")
  attempts     Int           @default(0)
  error        String?
  message_id   String?
  from_address String?
  sent_at      DateTime?
  next_try_at  DateTime?
  organization  String?
  /// outreach: where the address was found and why this company was chosen
  source_note   String?
  reason_note   String?   @db.Text
  /// role (info@, sales@) | personal (name@company) | freemail (gmail...)
  address_type  String?
  /// 0 = first email, 1-2 = follow-ups
  step          Int       @default(0)
  draft_subject String?
  draft_body    String?   @db.Text
  draft_error   String?
  message_ids   String[]  @default([])
  next_step_at  DateTime?
  /// replied | opted_out | bounced | no_reply
  outcome       String?
  reply_snippet String?   @db.Text
  replied_at    DateTime?
  events        Json      @default("[]")
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  campaign     EmailCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, email])
  @@index([campaign_id, status])
  @@index([from_address, sent_at])
  @@map("email_campaign_recipients")
}

model EmailSuppression {
  id         String   @id @default(uuid())
  company_id String
  email      String
  /// unsubscribed | bounced | manual
  reason     String
  note       String?
  created_at DateTime @default(now())
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, email])
  @@map("email_suppressions")
}

/// One row (id = "global"): limits AIStaff staff set for every tenant.
model EmailEnginePlatform {
  id             String   @id @default("global")
  paused_all     Boolean  @default(false)
  pause_note     String?
  max_per_minute Int      @default(30)
  max_per_day    Int      @default(3000)
  outreach_enabled     Boolean  @default(true)
  outreach_max_per_day Int      @default(50)
  /// Domains outreach may never send from (AIStaff main domain etc.)
  protected_domains    String[] @default(["aistaff.click"])
  updated_by     String?
  updated_at     DateTime @updatedAt

  @@map("email_engine_platform")
}
