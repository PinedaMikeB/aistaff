generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String                  @id @default(uuid())
  // Human-readable tenant reference (AIS-2026-0001). The customer's accountant
  // puts this on purchase orders and bank-transfer remittance slips, and both
  // sides say it out loud on support calls. NOT an identity key — `id` is.
  // One per serviced workspace, so a payer running two businesses can split
  // the cost across their own books.
  account_number     String?                 @unique
  name               String
  /// The real person we deal with — who answers when we call about their
  /// account. `name` is the business; this is the human. Added 2026-08-17
  /// because support calls and the live-data assessment both need a name to
  /// ask for, and "AIStaff.click Demo Company" is not a person.
  contact_person     String?
  industry           String?
  website            String?
  contact_email      String?
  contact_number     String?
  status             String                  @default("active")
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt
  users              User[]
  settings           CompanySetting?
  facebook_pages     FacebookPage[]
  knowledge_base     KnowledgeBase[]
  knowledge_gaps     KnowledgeGap[]
  qualification_questions QualificationQuestion[]
  conversations      Conversation[]
  messages           Message[]
  subscriptions      Subscription[]
  leads              Lead[]
  quotation_templates QuotationTemplate[]
  quotations         Quotation[]
  follow_ups         FollowUp[]
  booking_settings   BookingSetting?
  booking_services   BookingService[]
  bookings           Booking[]
  human_handoffs     HumanHandoff[]
  ai_logs            AiLog[]

  @@map("companies")
}

model User {
  id            String    @id @default(uuid())
  company_id    String
  name          String
  email         String    @unique
  password_hash String
  role          String    @default("admin")
  status        String    @default("active")
  // Global AIStaff platform role — independent of the tenant-scoped `role`
  // field above. Null for ordinary tenant users. Only ever set server-side
  // (CLI bootstrap script or an authenticated SUPERADMIN action); never
  // accepted from public signup or client-supplied request bodies.
  platform_role String?
  mfa_enabled   Boolean   @default(false)
  // Encrypted (not plaintext) TOTP secret — see src/crypto.js encryptSecret,
  // the same helper already used for facebook_pages.page_access_token_encrypted.
  mfa_secret_encrypted  String?
  mfa_backup_codes_hash String[] @default([])
  // Bumped whenever every existing session for this user must die at once:
  // password reset, password change, forced logout. The value is embedded in
  // the JWT and compared on every request. Without this a stateless 8h JWT
  // stays valid AFTER a reset, so an attacker keeps their session for up to
  // 8 hours and the reset achieves nothing.
  session_epoch Int      @default(0)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  company       Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  assigned_leads Lead[]   @relation("LeadAssignedTo")
  prepared_quotations Quotation[] @relation("QuotationPreparedBy")
  approved_quotations Quotation[] @relation("QuotationApprovedBy")
  assigned_followups FollowUp[] @relation("FollowUpAssignedTo")
  assigned_handoffs HumanHandoff[] @relation("HandoffAssignedTo")
  carts         Cart[]
  customers     Customer[]
  admin_audit_logs AdminAuditLog[] @relation("AdminAuditActor")
  password_reset_tokens PasswordResetToken[]

  @@index([platform_role])
  @@map("users")
}

// Append-only (by application convention — no update/delete API is ever
// exposed for this model) audit trail for every AIStaff Super Admin action.
model AdminAuditLog {
  id             String   @id @default(uuid())
  actor_user_id  String
  actor_role     String
  action         String
  target_type    String
  target_id      String?
  ip_address     String?
  user_agent     String?
  metadata       Json?
  created_at     DateTime @default(now())
  actor          User     @relation("AdminAuditActor", fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@index([actor_user_id])
  @@index([action])
  @@index([target_type, target_id])
  @@index([created_at])
  @@map("admin_audit_logs")
}

model CompanySetting {
  id                                String   @id @default(uuid())
  company_id                        String   @unique
  ai_enabled                        Boolean  @default(true)
  auto_reply_enabled                Boolean  @default(true)
  business_hours_only               Boolean  @default(false)
  human_handoff_enabled             Boolean  @default(true)
  default_language                  String   @default("en")
  tone                              String   @default("polite_professional")
  quotation_mode                    String   @default("approval_required")
  allow_ai_quotation_drafts         Boolean  @default(true)
  allow_auto_send_quotation         Boolean  @default(false)
  quotation_requires_admin_approval Boolean  @default(true)
  notify_email                      String?
  ai_custom_instructions            String?  @db.Text
  /// Intake wizard state: { industryPack, currentStep, completed: [stepId],
  /// skipped: [stepId] }. Progress must survive leaving the page — an owner
  /// who loses six steps of typing does not come back.
  intake_progress                   Json?
  intake_completed_at               DateTime?
  /// What the customer uses today for live availability: none | paper |
  /// google_sheet | google_calendar | own_system. Recorded by the last wizard
  /// step. Closer reads this to be honest about what it can confirm; it does
  /// NOT activate any integration.
  live_data_source                  String?
  live_data_interest                Boolean  @default(false)
  created_at                        DateTime @default(now())
  updated_at                        DateTime @updatedAt
  company                           Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model FacebookPage {
  id                          String         @id @default(uuid())
  company_id                  String
  page_id                     String         @unique
  page_name                   String
  page_access_token_encrypted String
  status                      String         @default("active")
  created_at                  DateTime       @default(now())
  updated_at                  DateTime       @updatedAt
  company                     Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  conversations               Conversation[]

  @@map("facebook_pages")
}

/// A record of AIStaff staff entering a customer's workspace to help.
///
/// Added 2026-08-19 with /platform. Staff reading a tenant's conversations is a
/// real intrusion — those threads contain the tenant's own customers' messages,
/// phone numbers and buying intent. The audit trail is what makes assisting
/// defensible: who entered, whose workspace, when, and why.
///
/// Written on ENTRY, not on exit, so an abandoned session is still recorded.
model AssistSession {
  id            String    @id @default(uuid())
  /// The AIStaff user doing the assisting.
  staff_user_id String
  staff_email   String
  /// The tenant being assisted.
  company_id    String
  company_name  String
  reason        String?
  started_at    DateTime  @default(now())
  ended_at      DateTime?

  @@index([company_id, started_at])
  @@index([staff_user_id, started_at])
  @@map("assist_sessions")
}

/// A question a real customer asked that Closer could not answer.
///
/// Added 2026-08-18. This is the mechanism behind ongoing improvement support:
/// real unanswered customer questions turn into specific knowledge-base work
/// without anyone remembering to manually track them.
///
/// The FAQ step predicts what customers will ask. This records what they
/// ACTUALLY asked and got no answer to, which is better evidence: it is
/// specific to this business, ranked by real frequency, and it never stops
/// arriving. §6 calls this the highest-value feature nobody else builds.
///
/// Closer flags these itself — it already knows when it had to say it could
/// not confirm something, so no keyword matching or guesswork is involved.
model KnowledgeGap {
  id              String   @id @default(uuid())
  company_id      String
  /// The customer's question, in their own words.
  question        String
  /// Short label the model assigns, so near-identical questions group.
  topic           String
  conversation_id String?
  /// open | answered | dismissed
  status          String   @default("open")
  /// Incremented when the same topic comes up again — this is what ranks the
  /// list by what is actually costing sales.
  times_asked     Int      @default(1)
  last_asked_at   DateTime @default(now())
  created_at      DateTime @default(now())
  company         Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id, status, times_asked])
  @@map("knowledge_gaps")
}

/// Which model runs which function. Editable in AI Studio, no deploy needed.
///
/// Added 2026-08-18. Model choices were scattered across .env and code
/// defaults and had already drifted — GEMINI_MODEL still said
/// "gemini-1.5-flash", which is what a provider switch would silently have
/// used. Nobody chose that; it was just never updated.
///
/// Same reasoning as PromptRevision: the things that decide how Closer behaves
/// belong somewhere a human can see and change, not buried in code.
model ModelSetting {
  /// Function key, e.g. "closer_reply", "upload_relevance", "vision_extract".
  fn         String   @id
  provider   String
  model      String
  /// Free text so a new model can be added without a migration.
  note       String?
  updated_by String?
  updated_at DateTime @updatedAt

  @@map("model_settings")
}

/// A versioned, human-editable instruction block for an agent.
///
/// Added 2026-08-18. Closer's operating instructions used to live as string
/// literals inside buildGuardrailPrompt() — invisible to the person running the
/// business, unchangeable without a deploy, and with no record of what changed
/// or when. That is the same "hardcoded copy" mistake this codebase forbids
/// everywhere else, applied to the most important text in the product.
///
/// Every save writes a NEW ROW rather than overwriting: the history is the
/// point. When a reply goes wrong you need to know which instructions were live
/// at the time, and be able to put the previous set back immediately.
///
/// Rollback flips `is_active` to an earlier revision rather than copying its
/// text forward, so the log stays an honest record of what was actually run.
///
/// This holds INSTRUCTIONS ONLY. Company name, knowledge base, lead state and
/// the customer's message are assembled in code around it — so an edit here can
/// change behaviour but can never break variable substitution.
model PromptRevision {
  id         String   @id @default(uuid())
  /// Which instruction block. "closer_system" is the Messenger reply prompt.
  key        String
  version    Int
  content    String   @db.Text
  /// Why this change was made — shown in the revision list.
  note       String?
  /// Email of whoever saved it. Null for the seeded original.
  created_by String?
  is_active  Boolean  @default(false)
  created_at DateTime @default(now())

  @@unique([key, version])
  @@index([key, is_active])
  @@map("prompt_revisions")
}

/// One unit of business knowledge the agent may answer from.
///
/// Was Q&A-only. Widened 2026-08-17 for the intake wizard: a sales agent needs
/// price lists, promos, policies, shipping tables and media, which are not
/// questions. Nothing was renamed or dropped — existing rows are kind="qa" and
/// behave exactly as before.
///
/// RULE 2 (docs/handoff-masterplan.md): every field here is a FACT. Never store
/// a sentence for the agent to recite. The model writes the words at reply time.
model KnowledgeBase {
  id         String   @id @default(uuid())
  company_id String
  category   String
  /// qa | prose | pricelist | promo | policy | shipping | media | instruction
  /// Controls how buildGuardrailPrompt renders the row. Unknown kinds fall
  /// back to prose rendering rather than being dropped.
  kind       String   @default("qa")
  /// Human label for non-Q&A rows ("Mission and vision", "Shipping rates").
  /// A price list is not a question and must not be forced into one.
  title      String?
  /// Only kind="qa" rows have a question. Nullable since 2026-08-17.
  question   String?
  answer     String
  /// Structured rows for tabular kinds: shipping rates by area, spec tables,
  /// price rows. Prose in a prompt makes the model do lookup and arithmetic in
  /// a paragraph; rows let it read one line. Shape: [{label, value, note}].
  data       Json?
  media      Json?    // [{type: "video"|"image"|"pdf", url, caption}] — lets the agent send actual files when asked, not just describe them
  /// NULL = no expiry, which is the common case and the wizard default outside
  /// the promo step. Set for anything dated. Promos auto-deactivate on expiry;
  /// prices and policies only flag for review — see src/knowledge-base.js.
  valid_until DateTime?
  /// Where this came from, so the wizard can show its source ("from
  /// pricelist-aug.xlsx"). A suggestion with no source must never be stored:
  /// an invented fact served for months is §9's phantom pricing at scale.
  source_name String?
  /// upload | facebook_page | website | typed — how we obtained it.
  source_kind String?
  /// ISO code for any amounts in this row. DemoSession learned this the hard
  /// way: "100" read off a US store and quoted as ₱100 is a number the
  /// business gets held to.
  currency    String?
  /// TRUE by default on purpose. Anything a human typed or saved is confirmed
  /// by that act, and defaulting false would have silently dropped the 6
  /// existing rows out of the prompt on migration. Only the AI-suggestion path
  /// writes false, and unconfirmed rows never reach the agent.
  confirmed   Boolean  @default(true)
  display_order Int    @default(0)
  tags       String[] @default([])
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id, active, kind])
  @@map("knowledge_base")
}

model QualificationQuestion {
  id            String   @id @default(uuid())
  company_id    String
  question      String
  field_key     String
  required      Boolean  @default(true)
  display_order Int      @default(0)
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  company       Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("qualification_questions")
}

model Conversation {
  id               String         @id @default(uuid())
  company_id       String
  facebook_page_id String?
  psid             String?
  external_id      String?
  contact_number   String?
  customer_name    String?
  /// Facebook profile picture URL, fetched once from the Graph API on the
  /// first message. Added 2026-08-19 so the inquiry list shows a face and a
  /// real name instead of a 17-digit PSID.
  ///
  /// NOTE: Meta's profile_pic URLs are signed and EXPIRE, so this is a
  /// convenience for the dashboard, not durable storage. A broken image is
  /// expected after a while and the initials fallback covers it.
  profile_pic_url  String?
  /// When we last asked Meta for this profile, so we do not re-fetch on every
  /// message.
  profile_fetched_at DateTime?
  channel          String         @default("facebook_messenger")
  status           String         @default("open")
  intent           String?
  lead_score       String         @default("cold")
  needs_human      Boolean        @default(false)
  last_message_at  DateTime       @default(now())
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  company          Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  facebook_page    FacebookPage?  @relation(fields: [facebook_page_id], references: [id], onDelete: SetNull)
  messages         Message[]
  leads            Lead[]
  quotations       Quotation[]
  follow_ups       FollowUp[]
  bookings         Booking[]
  human_handoffs   HumanHandoff[]
  ai_logs          AiLog[]
  source_orders     Order[]        @relation("OrderSourceConversation")

  @@unique([company_id, psid])
  @@unique([company_id, channel, external_id])
  @@map("conversations")
}

model Message {
  id              String       @id @default(uuid())
  company_id      String
  conversation_id String
  sender_type     String
  sender_id       String?
  message_text    String
  ai_generated    Boolean      @default(false)
  /// Files attached to this message: [{type, url, caption}].
  ///
  /// Added 2026-08-18 because Closer sent the SAME image twice in one
  /// conversation. The transcript only held text, so the model had no way to
  /// know it had already attached something — every turn it saw the entry
  /// saying "send this image when asked about X" and sent it again.
  /// Recording what went out is what makes "do not repeat" possible.
  attachments     Json?
  created_at      DateTime     @default(now())
  company         Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Lead {
  id                String       @id @default(uuid())
  company_id        String
  conversation_id   String
  customer_name     String?
  mobile_number     String?
  email             String?
  company_name      String?
  location          String?
  service_needed    String?
  budget            String?
  urgency           String?
  notes             String?
  lead_status       String       @default("new")
  lead_score        String       @default("cold")
  quotation_ready   Boolean      @default(false)
  assigned_to       String?
  follow_up_date    DateTime?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  company           Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  assigned_user     User?        @relation("LeadAssignedTo", fields: [assigned_to], references: [id], onDelete: SetNull)
  quotations        Quotation[]
  follow_ups        FollowUp[]
  bookings          Booking[]

  @@map("leads")
}

model QuotationTemplate {
  id                String    @id @default(uuid())
  company_id        String
  template_name     String
  service_type      String
  description       String?
  pricing_type      String    @default("range")
  fixed_price       Decimal?  @db.Decimal(12, 2)
  price_min         Decimal?  @db.Decimal(12, 2)
  price_max         Decimal?  @db.Decimal(12, 2)
  terms             String?
  validity_days     Int       @default(15)
  auto_send_allowed Boolean   @default(false)
  active            Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  company           Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("quotation_templates")
}

model Quotation {
  id                 String          @id @default(uuid())
  company_id         String
  lead_id            String
  conversation_id    String
  quotation_number   String          @unique
  customer_name      String?
  customer_company   String?
  service_needed     String?
  quotation_details  String
  amount             Decimal?        @db.Decimal(12, 2)
  terms              String?
  status             String          @default("draft")
  mode               String          @default("approval_required")
  prepared_by        String?
  approved_by        String?
  sent_at            DateTime?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  company            Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  lead               Lead            @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  conversation       Conversation    @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  prepared_user      User?           @relation("QuotationPreparedBy", fields: [prepared_by], references: [id], onDelete: SetNull)
  approved_user      User?           @relation("QuotationApprovedBy", fields: [approved_by], references: [id], onDelete: SetNull)
  items              QuotationItem[]

  @@map("quotations")
}

model QuotationItem {
  id            String    @id @default(uuid())
  quotation_id  String
  item_name     String
  description   String?
  quantity      Decimal   @default(1) @db.Decimal(10, 2)
  unit_price    Decimal?  @db.Decimal(12, 2)
  total_price   Decimal?  @db.Decimal(12, 2)
  created_at    DateTime  @default(now())
  quotation     Quotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

model FollowUp {
  id              String       @id @default(uuid())
  company_id      String
  lead_id         String
  conversation_id String
  due_date        DateTime
  status          String       @default("pending")
  note            String?
  assigned_to     String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  company         Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  lead            Lead         @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  assigned_user   User?        @relation("FollowUpAssignedTo", fields: [assigned_to], references: [id], onDelete: SetNull)

  @@map("follow_ups")
}

model BookingSetting {
  id                    String   @id @default(uuid())
  company_id            String   @unique
  enabled               Boolean  @default(false)
  timezone              String   @default("Asia/Manila")
  slot_interval_minutes Int      @default(30)
  min_notice_minutes    Int      @default(120)
  max_days_ahead        Int      @default(30)
  business_hours        Json     @default("{}")
  booking_type          String   @default("general")
  field_mode            String   @default("preset")
  required_fields       Json     @default("[]")
  instructions          String?  @db.Text
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  company               Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("booking_settings")
}

model BookingService {
  id               String    @id @default(uuid())
  company_id       String
  name             String
  description      String?   @db.Text
  duration_minutes Int       @default(60)
  price            Decimal?  @db.Decimal(12, 2)
  deposit_amount   Decimal?  @db.Decimal(12, 2)
  location         String?
  active           Boolean   @default(true)
  display_order    Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  company          Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  bookings         Booking[]

  @@index([company_id, active])
  @@map("booking_services")
}

model Booking {
  id              String          @id @default(uuid())
  company_id      String
  service_id      String?
  conversation_id String?
  lead_id         String?
  customer_name   String
  mobile_number   String?
  email           String?
  service_name    String
  start_at        DateTime
  end_at          DateTime
  status          String          @default("requested") // requested | pending_confirmation | confirmed | paid | cancelled | completed | no_show
  source          String          @default("admin")
  field_values    Json            @default("{}")
  notes           String?         @db.Text
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  company         Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  service         BookingService? @relation(fields: [service_id], references: [id], onDelete: SetNull)
  conversation    Conversation?   @relation(fields: [conversation_id], references: [id], onDelete: SetNull)
  lead            Lead?           @relation(fields: [lead_id], references: [id], onDelete: SetNull)

  @@index([company_id, start_at])
  @@index([company_id, status])
  @@index([service_id])
  @@index([conversation_id])
  @@index([lead_id])
  @@map("bookings")
}

model HumanHandoff {
  id              String       @id @default(uuid())
  company_id      String
  conversation_id String
  reason          String
  status          String       @default("open")
  assigned_to     String?
  created_at      DateTime     @default(now())
  resolved_at     DateTime?
  company         Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  assigned_user   User?        @relation("HandoffAssignedTo", fields: [assigned_to], references: [id], onDelete: SetNull)

  @@map("human_handoffs")
}

model AiLog {
  id                String       @id @default(uuid())
  company_id        String
  conversation_id   String?
  model             String
  prompt_tokens     Int          @default(0)
  completion_tokens Int          @default(0)
  cost_estimate     Decimal?     @db.Decimal(10, 6)
  created_at        DateTime     @default(now())
  company           Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  conversation      Conversation? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)

  @@map("ai_logs")
}

model Product {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String       @db.Text
  status        String        @default("active")
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  pricing_plans PricingPlan[]

  @@map("products")
}

model PricingPlan {
  id                  String        @id @default(uuid())
  product_id          String
  name                String
  slug                String        @unique
  monthly_price       Decimal       @db.Decimal(12, 2)
  annual_price        Decimal       @db.Decimal(12, 2)
  currency            String        @default("PHP")
  conversation_limit  Int
  facebook_page_limit Int
  features            Json
  active              Boolean       @default(true)
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  product             Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  subscriptions       Subscription[]

  @@index([product_id])
  @@index([active])
  @@map("pricing_plans")
}

model AddOn {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("PHP")
  billing_type String
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([active])
  @@map("add_ons")
}

model Cart {
  id          String     @id @default(uuid())
  user_id     String?
  guest_token String?
  status      String     @default("active")
  currency    String     @default("PHP")
  subtotal    Decimal    @default(0) @db.Decimal(12, 2)
  tax         Decimal    @default(0) @db.Decimal(12, 2)
  total       Decimal    @default(0) @db.Decimal(12, 2)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  user        User?      @relation(fields: [user_id], references: [id], onDelete: SetNull)
  items       CartItem[]
  orders      Order[]

  @@index([user_id])
  @@index([guest_token])
  @@index([status])
  @@map("carts")
}

model CartItem {
  id                String   @id @default(uuid())
  cart_id           String
  item_type         String
  item_id           String
  item_name         String
  billing_frequency String
  unit_price        Decimal  @db.Decimal(12, 2)
  quantity          Int      @default(1)
  line_total        Decimal  @db.Decimal(12, 2)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  cart              Cart     @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  @@index([cart_id])
  @@index([item_type, item_id])
  @@map("cart_items")
}

model Customer {
  id                          String         @id @default(uuid())
  user_id                     String?
  full_name                   String
  company_name                String?
  business_name               String?
  email                       String
  mobile_number               String
  billing_address             String
  city                        String
  province                    String
  postal_code                 String
  country                     String
  tax_id                      String?
  company_registration_number String?
  business_website            String?
  facebook_page_url           String?
  industry                    String?
  estimated_monthly_inquiries String?
  main_products_or_services   String?
  preferred_onboarding_date   DateTime?
  created_at                  DateTime       @default(now())
  updated_at                  DateTime       @updatedAt
  user                        User?          @relation(fields: [user_id], references: [id], onDelete: SetNull)
  orders                      Order[]
  subscriptions               Subscription[]
  invoices                    Invoice[]
  brandee_entitlement_events  BrandeeEntitlementEvent[]

  @@index([user_id])
  @@index([email])
  @@map("customers")
}

model Order {
  id                    String      @id @default(uuid())
  order_number          String      @unique
  customer_id           String
  cart_id               String?
  subtotal              Decimal     @db.Decimal(12, 2)
  tax                   Decimal     @default(0) @db.Decimal(12, 2)
  total                 Decimal     @db.Decimal(12, 2)
  currency              String      @default("PHP")
  billing_frequency     String
  payment_provider      String
  payment_status        String      @default("pending")
  order_status          String      @default("awaiting_payment")
  external_payment_id   String?
  external_checkout_url String?
  /// Messenger/source conversation that created this checkout link. This lets
  /// payment webhooks send the post-payment onboarding message back to the same
  /// chat instead of guessing by email.
  source_conversation_id String?
  paid_at               DateTime?
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt
  customer              Customer    @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  cart                  Cart?       @relation(fields: [cart_id], references: [id], onDelete: SetNull)
  source_conversation   Conversation? @relation("OrderSourceConversation", fields: [source_conversation_id], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  payments              Payment[]
  subscriptions         Subscription[]
  invoices              Invoice[]
  manual_payment_proofs ManualPaymentProof[]

  @@index([customer_id])
  @@index([cart_id])
  @@index([payment_status])
  @@index([order_status])
  @@index([external_payment_id])
  @@index([source_conversation_id])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid())
  order_id          String
  item_type         String
  item_id           String
  item_name         String
  billing_frequency String
  unit_price        Decimal  @db.Decimal(12, 2)
  quantity          Int      @default(1)
  line_total        Decimal  @db.Decimal(12, 2)
  created_at        DateTime @default(now())
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_items")
}

model Payment {
  id                  String    @id @default(uuid())
  order_id            String
  provider            String
  provider_payment_id String?
  payment_method      String?
  amount              Decimal   @db.Decimal(12, 2)
  currency            String    @default("PHP")
  status              String    @default("pending")
  provider_response   Json?
  paid_at             DateTime?
  failed_at           DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  order               Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([provider, provider_payment_id])
  @@index([status])
  @@map("payments")
}

model Subscription {
  id                       String      @id @default(uuid())
  customer_id              String
  // The tenant this subscription provisions. Nullable because subscriptions
  // predating tenant provisioning have no workspace, and because payment can
  // land before the Company is created. Customer = who pays; Company = what
  // they bought. One Customer may hold several, one per business.
  company_id               String?
  order_id                 String
  pricing_plan_id          String
  provider                 String
  provider_subscription_id String?
  billing_frequency        String
  amount                   Decimal     @db.Decimal(12, 2)
  currency                 String      @default("PHP")
  status                   String      @default("pending")
  current_period_start     DateTime?
  current_period_end       DateTime?
  cancel_at_period_end     Boolean     @default(false)
  cancelled_at             DateTime?
  created_at               DateTime    @default(now())
  updated_at               DateTime    @updatedAt
  customer                 Customer    @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  company                  Company?    @relation(fields: [company_id], references: [id], onDelete: SetNull)
  order                    Order       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  pricing_plan             PricingPlan @relation(fields: [pricing_plan_id], references: [id], onDelete: Restrict)

  @@index([customer_id])
  @@index([company_id])
  @@index([order_id])
  @@index([pricing_plan_id])
  @@index([status])
  @@map("subscriptions")
}

model WebhookEvent {
  id                 String    @id @default(uuid())
  provider           String
  external_event_id  String
  event_type         String
  payload            Json
  signature_verified Boolean   @default(false)
  processing_status  String    @default("received")
  processed_at       DateTime?
  created_at         DateTime  @default(now())

  @@unique([provider, external_event_id])
  @@index([provider, event_type])
  @@index([processing_status])
  @@map("webhook_events")
}

model Invoice {
  id             String    @id @default(uuid())
  order_id       String
  invoice_number String    @unique
  customer_id    String
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("PHP")
  status         String    @default("pending")
  due_date       DateTime?
  paid_at        DateTime?
  invoice_url    String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  order          Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  customer       Customer  @relation(fields: [customer_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([customer_id])
  @@index([status])
  @@map("invoices")
}

// ===========================================================================
// Brandee — Super Admin-managed creative templates (PART 9/15 of the
// template-admin task). Two parallel model families (static image templates
// vs UGC/video templates) rather than one polymorphic table, since their
// schemas genuinely diverge (overlaySchema vs storyboardSchema/sceneSchema).
//
// Versioning (PART 25): editing a PUBLISHED template does not mutate it.
// `version` + `parentTemplateId` let a new row link back to the template it
// supersedes; existing customer projects store the exact template `id` +
// `version` they used (in the JSON project store — see productAdProjectStore.js)
// so a later edit never silently changes an already-generated project. Only
// the newest ACTIVE version of a given `slug` is offered to new projects.
// ===========================================================================
model StaticAdTemplate {
  id                    String    @id @default(uuid())
  slug                  String
  name                  String
  description           String    @db.Text
  category              String
  frameworkKey          String?
  // PRODUCT | SERVICE | UNIVERSAL — which example this specific template
  // visual is (most frameworks were imported with one product-oriented and
  // one service-oriented real example; see templateImport.js).
  audienceType          String    @default("UNIVERSAL")
  // Short "best for X" customer-facing label (PART 4/7), distinct from the
  // longer `description`.
  idealFor              String?   @db.Text
  // Dominant colors sampled from the source asset at import time, hex
  // strings — used for personalized-thumbnail color hints (PART 8) and
  // Super Admin preview only, never as the sole indicator of anything.
  dominantColors        String[]  @default([])
  // SHA-256 of the original imported file's bytes — lets the importer
  // (scripts/brandee-import-static-templates.js) detect an already-imported
  // file on a safe rerun without depending on filename stability.
  sourceChecksum        String?
  // Original filename from the import source, kept for provenance/audit only
  // (never used at runtime, never exposed as a public asset path).
  importedFromFilename  String?
  previewImageUrl       String?
  thumbnailUrl          String?
  sourceAssetUrl        String?
  // Editable overlay areas (product image/logo/headline/price/CTA/etc.) as
  // normalized-coordinate bounding boxes — see overlaySchema shape documented
  // in src/brandee/templateSchemas.js. Validated with Zod before every write.
  overlaySchema         Json      @default("{}")
  requiredFieldsSchema  Json      @default("[]")
  optionalFieldsSchema  Json      @default("[]")
  proofRequirements     Json      @default("[]")
  // Art direction for the AI_GENERATED_LAYOUT render mode: describes the
  // LAYOUT and VISUAL STYLE this framework should produce (columns, badge,
  // palette, photography mood) — never the customer's actual copy, which
  // comes from their field answers at generation time. GPT-5.6 Sol merges
  // this with those answers into the final GPT Image 2 prompt (see
  // creativePlanner.composeImagePrompt). Null = this template stays on the
  // deterministic SVG compositor.
  imageGenPrompt        String?   @db.Text
  supportedAspectRatios Json      @default("[]")
  defaultAspectRatio    String    @default("4:5")
  defaultLanguage       String    @default("english")
  renderMode            String    @default("COMPOSITE_TEMPLATE") // COMPOSITE_TEMPLATE | AI_GENERATED_LAYOUT
  tags                  String[]  @default([])
  sortOrder             Int       @default(0)
  status                String    @default("DRAFT") // DRAFT | ACTIVE | INACTIVE | ARCHIVED
  isFeatured            Boolean   @default(false)
  isPremium             Boolean   @default(false)
  version               Int       @default(1)
  parentTemplateId      String?
  publishedAt           DateTime?
  retiredAt             DateTime?
  createdByPlatformUserId String?
  updatedByPlatformUserId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt             DateTime?

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([parentTemplateId])
  @@index([sourceChecksum])
  @@map("static_ad_templates")
}

model UgcTemplate {
  id                    String    @id @default(uuid())
  slug                  String
  name                  String
  description           String    @db.Text
  category              String
  previewPosterUrl      String?
  previewVideoUrl       String?
  sourceAssetUrl        String?
  storyboardSchema      Json      @default("{}")
  sceneSchema           Json      @default("[]")
  creatorRequirements   Json      @default("{}")
  voiceRequirements     Json      @default("{}")
  scriptSchema          Json      @default("{}")
  requiredFieldsSchema  Json      @default("[]")
  optionalFieldsSchema  Json      @default("[]")
  proofRequirements     Json      @default("[]")
  supportedDurations    Json      @default("[]")
  supportedAspectRatios Json      @default("[]")
  supportedLanguages    Json      @default("[]")
  // Safe provider identifiers/config ONLY — never a secret/API key. Enforced
  // by templateAdmin.js's scrubProviderConfiguration() before every write.
  modelProvider         String?
  providerConfiguration Json      @default("{}")
  tags                  String[]  @default([])
  sortOrder             Int       @default(0)
  status                String    @default("DRAFT")
  isFeatured            Boolean   @default(false)
  isPremium             Boolean   @default(false)
  version               Int       @default(1)
  parentTemplateId      String?
  publishedAt           DateTime?
  retiredAt             DateTime?
  createdByPlatformUserId String?
  updatedByPlatformUserId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt             DateTime?

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([parentTemplateId])
  @@map("ugc_templates")
}

// Draft/publish pricing + tax-mode configuration a SUPERADMIN can edit
// through /superadmin/brandee/pricing (PART 4/20) WITHOUT a code deploy.
// The runtime app reads the newest `status: "published"` row; if none
// exists yet, it falls back to the code-level defaults in pricingConfig.js
// (see pricingOverride.js). Editing never mutates a published row in place
// — publishing a new draft archives the previous published row, so the
// change is itself auditable/reversible via history, not just via the
// separate AdminAuditLog entry already written on publish.
model BrandeePricingConfig {
  id                      String    @id @default(uuid())
  status                  String    @default("draft") // draft | published | archived
  taxMode                 String    @default("NON_VAT") // NON_VAT | VAT
  pricesAreTaxInclusive   Boolean   @default(true)
  vatRatePercent          Decimal   @default(12) @db.Decimal(5, 2)
  // Array of plan objects — same shape as pricingConfig.js's PLANS constant.
  plans                   Json
  publishedAt             DateTime?
  createdByPlatformUserId String?
  updatedByPlatformUserId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([status])
  @@map("brandee_pricing_configs")
}

// Entitlement ledger (PART 27) — IMAGE_FINAL / VIDEO_SECONDS only, never a
// generic "credits" number. Append-only event log (RESERVE/CONSUME/RELEASE/
// REFUND); the remaining balance for a billing period is always DERIVED by
// summing events, never stored as a single mutable counter, so a crashed
// request can never silently double-spend or lose an entitlement.
model BrandeeEntitlementEvent {
  id              String   @id @default(uuid())
  customer_id     String
  subscription_id String?
  unit            String   // IMAGE_FINAL | VIDEO_SECONDS
  eventType       String   // RESERVE | CONSUME | RELEASE | REFUND
  amount          Int
  // References a project in the JSON-file product-ad project store
  // (productAdProjectStore.js), not a Postgres FK — that store is
  // intentionally outside Postgres for this MVP (see its own header comment).
  projectId       String?
  // Unique per (idempotencyKey, eventType) rather than idempotencyKey alone:
  // a RESERVE and its later RELEASE/CONSUME settlement event intentionally
  // share the SAME idempotencyKey (so computeRemaining() in entitlements.js
  // can group them together and cancel a released reservation out of the
  // balance) — only a duplicate RESERVE (or duplicate RELEASE/CONSUME) of
  // the exact same event is actually meant to be rejected.
  idempotencyKey  String
  reason          String?
  createdAt       DateTime @default(now())
  customer        Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey, eventType])
  @@index([customer_id, unit])
  @@index([subscription_id])
  @@index([idempotencyKey])
  @@map("brandee_entitlement_events")
}

model ManualPaymentProof {
  id                    String    @id @default(uuid())
  order_id              String
  transaction_reference String
  payment_date          DateTime
  sender_name           String
  amount_sent           Decimal   @db.Decimal(12, 2)
  proof_file_url        String?
  status                String    @default("awaiting_verification")
  admin_notes           String?   @db.Text
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  order                 Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([status])
  @@map("manual_payment_proofs")
}


// Product-ad project (image/video flow) — was a lightweight JSON-file store
// (productAdProjectStore.js), explicitly documented in its own header as an
// MVP-only pattern ("no new Prisma model/migration needed for MVP volumes
// ... migrate to a real table if volume grows"). Migrated now because: (1)
// uploaded product images move to real files on disk (ProductAdImageAsset
// below) referenced by URL instead of embedded as base64 blobs, which
// needed real disk-backed rows anyway; (2) growing multi-customer volume
// made per-write full-file read/write with zero concurrent-write safety a
// real risk. BrandeeEntitlementEvent.projectId (above) is a loose string
// reference by design, not a Postgres FK — this model keeps `id` as a UUID
// string so those existing references keep resolving with no changes.
model ProductAdProject {
  id                  String   @id @default(uuid())
  kind                String // "image" | "video"
  anonymousSessionId  String?
  userId              String?
  product             Json     @default("{}")
  templateId          String?
  styleId             String?
  templateFields      Json     @default("{}")
  videoFields         Json     @default("{}")
  preview             Json?
  finalAsset          Json?
  creativePlan        Json?
  analysis            Json?
  suggestionDecisions Json     @default("{}")
  status              String   @default("draft")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  revisions ProductAdRevision[]
  images    ProductAdImageAsset[]

  @@index([anonymousSessionId])
  @@index([userId])
  @@index([status])
  @@map("product_ad_projects")
}

// Append-only revision history (unchanged semantics from the JSON store's
// addRevision/listRevisions/restoreRevision — nothing is ever overwritten
// or deleted, so the customer can always view/compare/restore an earlier
// version).
model ProductAdRevision {
  id             String   @id @default(uuid())
  projectId      String
  revisionNumber Int
  instruction    String?  @db.Text
  plan           Json?
  svg            String   @db.Text
  width          Int
  height         Int
  watermarked    Boolean  @default(true)
  aiUsed         Boolean  @default(false)
  createdAt      DateTime @default(now())

  project ProductAdProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, revisionNumber])
  @@index([projectId])
  @@map("product_ad_revisions")
}

// One uploaded customer image (product photo or logo) — a real file on
// disk (data/brandee-uploads/<scopeId>/<uuid>.<ext>, served at
// /uploads/brandee/<scopeId>/<uuid>.<ext>), never embedded as base64 here
// or in any generated SVG. `scopeId` (anonymousSessionId or userId) keeps
// each customer's uploads in their own directory.
model ProductAdImageAsset {
  id        String   @id @default(uuid())
  projectId String?
  scopeId   String
  role      String   @default("product") // "product" | "logo"
  url       String
  filePath  String
  mimeType  String
  bytes     Int
  width     Int?
  height    Int?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  project ProductAdProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([scopeId])
  @@map("product_ad_image_assets")
}

/// Password reset tokens.
///
/// The raw token is NEVER stored. Only sha256(token) is persisted, so a
/// database leak yields nothing usable — the same reasoning that applies to
/// password hashes. The raw value exists only in the email we send.
///
/// Single use, short lived, and all of a user's outstanding tokens are
/// invalidated when any one of them is redeemed.
model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  /// sha256 hex of the raw token. Unique so redemption is a single indexed
  /// lookup rather than a scan — this is the hot path at scale.
  token_hash String   @unique
  expires_at DateTime
  used_at    DateTime?
  /// Recorded for abuse investigation, not for access decisions.
  requested_ip String?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

/// A prospect trying Closer on their OWN business data, before buying.
///
/// Deliberately NOT a User or a Customer:
///   - the email is unverified, so anyone could type a competitor's address
///   - User.email is globally unique, so a demo row would BLOCK their real
///     signup later with a confusing "already registered"
///   - Customer is the billing record and must stay clean
///
/// `snapshot` is the scraped presence data from page-intelligence.js. Before
/// this table existed the scrape was formatted into a message body and thrown
/// away, so there was no way to review what the agent had learned, correct it,
/// or reuse it when the prospect bought. That reuse is exactly what the
/// setup fee covers.
model DemoSession {
  id             String    @id @default(uuid())
  name           String
  email          String
  /// E.164, normalised by src/phone.js. The ONLY number the demo will text —
  /// the model composes the message but never chooses the recipient.
  mobile_number  String?
  website_url    String?
  facebook_url   String?
  business_name  String?
  /// Structured output of buildPresenceSnapshot(). Facts only; the model
  /// writes every word it says (docs/handoff-masterplan.md).
  snapshot       Json?
  /// Plain text pulled from an uploaded price list (image, PDF, spreadsheet or
  /// doc). A Facebook Page can publish every price inside promo GRAPHICS,
  /// which Open Graph scraping cannot see — this is how those prices reach
  /// the agent. Facts only; the model writes its own words.
  price_list_text String?
  price_list_kind String?
  /// ISO code of the currency the scraped/uploaded prices are in. Without
  /// this the agent could read "$100" from a US store and quote it to a
  /// Filipino customer as if it were pesos.
  price_currency  String?
  price_list_name String?
  scrape_status  String    @default("pending")
  scrape_error   String?
  message_count  Int       @default(0)
  sms_sent       Int       @default(0)
  requested_ip   String?
  /// Retention limit. A stranger's business data and mobile number are
  /// personal data under the Data Privacy Act — purged, not kept forever.
  expires_at     DateTime
  converted_at   DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([email])
  @@index([expires_at])
  @@index([created_at])
  @@map("demo_sessions")
}
