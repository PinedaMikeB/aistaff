generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                          String                     @id @default(uuid())
  // Human-readable tenant reference (AIS-2026-0001). The customer's accountant
  // puts this on purchase orders and bank-transfer remittance slips, and both
  // sides say it out loud on support calls. NOT an identity key — `id` is.
  // One per serviced workspace, so a payer running two businesses can split
  // the cost across their own books.
  account_number              String?                    @unique
  name                        String
  /// The real person we deal with — who answers when we call about their
  /// account. `name` is the business; this is the human. Added 2026-08-17
  /// because support calls and the live-data assessment both need a name to
  /// ask for, and "AIStaff.click Demo Company" is not a person.
  contact_person              String?
  industry                    String?
  website                     String?
  contact_email               String?
  contact_number              String?
  status                      String                     @default("active")
  created_at                  DateTime                   @default(now())
  updated_at                  DateTime                   @updatedAt
  users                       User[]
  settings                    CompanySetting?
  facebook_pages              FacebookPage[]
  integration_connections     IntegrationConnection[]
  integration_actions         IntegrationAction[]
  integration_executions      IntegrationExecution[]
  tenant_engines              TenantEngine[]
  tenant_engine_fields        TenantEngineField[]
  tenant_engine_operations    TenantEngineOperation[]
  engine_operation_mappings   EngineOperationMapping[]
  business_operation_requests BusinessOperationRequest[]
  capability_gaps             CapabilityGap[]
  tenant_audit_logs           TenantAuditLog[]
  knowledge_base              KnowledgeBase[]
  knowledge_gaps              KnowledgeGap[]
  qualification_questions     QualificationQuestion[]
  conversations               Conversation[]
  messages                    Message[]
  website_events              WebsiteEvent[]
  subscriptions               Subscription[]
  leads                       Lead[]
  quotation_templates         QuotationTemplate[]
  quotations                  Quotation[]
  follow_ups                  FollowUp[]
  customer_update_templates   CustomerUpdateTemplate[]
  customer_update_deliveries  CustomerUpdateDelivery[]
  booking_settings            BookingSetting?
  booking_services            BookingService[]
  bookings                    Booking[]
  human_handoffs              HumanHandoff[]
  ai_logs                     AiLog[]
  tenant_channels             TenantChannel[]
  contact_profiles            ContactProfile[]
  customer_feedback           CustomerFeedback[]
  email_message_logs          EmailMessageLog[]
  staff_resolve_actions       StaffResolveAction[]
  sip_devices                 SipDevice[]
  email_engine_setting        EmailEngineSetting?
  email_contacts              EmailContact[]
  email_campaigns             EmailCampaign[]
  email_suppressions          EmailSuppression[]

  @@map("companies")
}

model User {
  id                    String               @id @default(uuid())
  company_id            String
  name                  String
  email                 String               @unique
  password_hash         String
  role                  String               @default("admin")
  status                String               @default("active")
  // Global AIStaff platform role — independent of the tenant-scoped `role`
  // field above. Null for ordinary tenant users. Only ever set server-side
  // (CLI bootstrap script or an authenticated SUPERADMIN action); never
  // accepted from public signup or client-supplied request bodies.
  platform_role         String?
  mfa_enabled           Boolean              @default(false)
  // Encrypted (not plaintext) TOTP secret — see src/crypto.js encryptSecret,
  // the same helper already used for facebook_pages.page_access_token_encrypted.
  mfa_secret_encrypted  String?
  mfa_backup_codes_hash String[]             @default([])
  // Bumped whenever every existing session for this user must die at once:
  // password reset, password change, forced logout. The value is embedded in
  // the JWT and compared on every request. Without this a stateless 8h JWT
  // stays valid AFTER a reset, so an attacker keeps their session for up to
  // 8 hours and the reset achieves nothing.
  session_epoch         Int                  @default(0)
  last_login_at         DateTime?
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  company               Company              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  assigned_leads        Lead[]               @relation("LeadAssignedTo")
  prepared_quotations   Quotation[]          @relation("QuotationPreparedBy")
  approved_quotations   Quotation[]          @relation("QuotationApprovedBy")
  assigned_followups    FollowUp[]           @relation("FollowUpAssignedTo")
  assigned_handoffs     HumanHandoff[]       @relation("HandoffAssignedTo")
  carts                 Cart[]
  customers             Customer[]
  admin_audit_logs      AdminAuditLog[]      @relation("AdminAuditActor")
  password_reset_tokens PasswordResetToken[]

  @@index([platform_role])
  @@map("users")
}

// Append-only (by application convention — no update/delete API is ever
// exposed for this model) audit trail for every AIStaff Super Admin action.
model AdminAuditLog {
  id            String   @id @default(uuid())
  actor_user_id String
  actor_role    String
  action        String
  target_type   String
  target_id     String?
  ip_address    String?
  user_agent    String?
  metadata      Json?
  created_at    DateTime @default(now())
  actor         User     @relation("AdminAuditActor", fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@index([actor_user_id])
  @@index([action])
  @@index([target_type, target_id])
  @@index([created_at])
  @@map("admin_audit_logs")
}

model CompanySetting {
  id                                String    @id @default(uuid())
  company_id                        String    @unique
  ai_enabled                        Boolean   @default(true)
  auto_reply_enabled                Boolean   @default(true)
  business_hours_only               Boolean   @default(false)
  human_handoff_enabled             Boolean   @default(true)
  default_language                  String    @default("en")
  tone                              String    @default("polite_professional")
  quotation_mode                    String    @default("approval_required")
  allow_ai_quotation_drafts         Boolean   @default(true)
  allow_auto_send_quotation         Boolean   @default(false)
  quotation_requires_admin_approval Boolean   @default(true)
  notify_email                      String?
  alert_contacts                    Json      @default("[]")
  /// Daily briefing report (Settings > General): { enabled, days [0-6, 0=Sun], time "HH:MM" Manila, sections {...}, last_sent_date }.
  briefing_settings                 Json      @default("{}")
  /// sha256 of the key the tenant's own system uses for POST /api/hooks/tenant-alert (src/routes/tenant-hooks.js).
  alert_hook_key_hash               String?
  ai_custom_instructions            String?   @db.Text
  lead_qualification_rules          Json?
  /// Intake wizard state: { industryPack, currentStep, completed: [stepId],
  /// skipped: [stepId] }. Progress must survive leaving the page — an owner
  /// who loses six steps of typing does not come back.
  intake_progress                   Json?
  intake_completed_at               DateTime?
  /// What the customer uses today for live availability: none | paper |
  /// google_sheet | google_calendar | own_system. Recorded by the last wizard
  /// step. Closer reads this to be honest about what it can confirm; it does
  /// NOT activate any integration.
  live_data_source                  String?
  live_data_interest                Boolean   @default(false)
  created_at                        DateTime  @default(now())
  updated_at                        DateTime  @updatedAt
  company                           Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model FacebookPage {
  id                          String                   @id @default(uuid())
  company_id                  String
  page_id                     String                   @unique
  page_name                   String
  page_access_token_encrypted String
  status                      String                   @default("active")
  created_at                  DateTime                 @default(now())
  updated_at                  DateTime                 @updatedAt
  company                     Company                  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  conversations               Conversation[]
  customer_update_templates   CustomerUpdateTemplate[]
  customer_update_deliveries  CustomerUpdateDelivery[]

  @@map("facebook_pages")
}

/// One tenant-owned connection to a custom application API.
///
/// Secrets are encrypted before they reach this table. The OpenAPI document is
/// stored as a versioned snapshot so Closer never discovers new write
/// operations from a changing remote document in the middle of a conversation.
model IntegrationConnection {
  id                     String                 @id @default(uuid())
  company_id             String
  name                   String
  base_url               String
  source_url             String?
  spec_source_url        String?
  openapi_spec           Json
  connection_type        String                 @default("rest_openapi")
  discovery_status       String                 @default("succeeded")
  discovery_message      String?
  discovery_metadata     Json?
  wizard_step            String                 @default("review")
  auth_type              String                 @default("none")
  auth_config            Json?
  auth_secret_encrypted  String?
  credential_status      String                 @default("unverified")
  credential_updated_at  DateTime?
  oauth_state_hash       String?
  oauth_pkce_encrypted   String?
  oauth_state_expires_at DateTime?
  api_version            String?
  behavior_config        Json?
  status                 String                 @default("draft")
  last_tested_at         DateTime?
  last_test_status       String?
  last_test_message      String?
  last_success_at        DateTime?
  disabled_at            DateTime?
  created_by             String?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  company                Company                @relation(fields: [company_id], references: [id], onDelete: Cascade)
  actions                IntegrationAction[]
  executions             IntegrationExecution[]

  @@unique([company_id, name])
  @@index([company_id, status])
  @@map("integration_connections")
}

/// A single OpenAPI operation exposed to Closer as a function.
///
/// `input_schema` is what the model sees. `request_config` maps those safe,
/// flat arguments back to path/query/header/body fields for the real request.
model IntegrationAction {
  id                      String                   @id @default(uuid())
  company_id              String
  connection_id           String
  operation_id            String
  tool_name               String
  display_name            String
  description             String
  http_method             String
  path                    String
  input_schema            Json
  request_config          Json
  enabled                 Boolean                  @default(false)
  category                String                   @default("other")
  risk_level              String                   @default("write")
  approval_policy         String                   @default("staff_approval")
  minimum_approval_policy String                   @default("staff_approval")
  is_high_impact          Boolean                  @default(false)
  source                  String                   @default("openapi")
  validated               Boolean                  @default(false)
  response_schema         Json?
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  company                 Company                  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  connection              IntegrationConnection    @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  executions              IntegrationExecution[]
  engine_mappings         EngineOperationMapping[]

  @@unique([connection_id, operation_id])
  @@unique([company_id, tool_name])
  @@index([company_id, enabled])
  @@map("integration_actions")
}

/// Platform-owned reusable engine definition. This table contains no
/// tenant-specific or MARGA-specific behavior.
model BusinessEngine {
  id                  String                      @id @default(uuid())
  key                 String                      @unique
  name                String
  description         String
  default_instruction String                      @db.Text
  catalog_version     Int                         @default(1)
  active              Boolean                     @default(true)
  display_order       Int                         @default(0)
  created_at          DateTime                    @default(now())
  updated_at          DateTime                    @updatedAt
  fields              EngineFieldDefinition[]
  operations          EngineOperationDefinition[]
  tenant_engines      TenantEngine[]

  @@index([active, display_order])
  @@map("business_engines")
}

model EngineFieldDefinition {
  id               String         @id @default(uuid())
  engine_id        String
  field_key        String
  label            String
  description      String?
  data_type        String         @default("string")
  default_enabled  Boolean        @default(true)
  default_required Boolean        @default(false)
  display_order    Int            @default(0)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  engine           BusinessEngine @relation(fields: [engine_id], references: [id], onDelete: Cascade)

  @@unique([engine_id, field_key])
  @@index([engine_id, display_order])
  @@map("engine_field_definitions")
}

model EngineOperationDefinition {
  id                String                  @id @default(uuid())
  engine_id         String
  operation_key     String
  name              String
  description       String
  operation_type    String
  required_fields   Json                    @default("[]")
  default_policy    String
  minimum_policy    String
  default_fallback  String                  @default("create_human_task")
  display_order     Int                     @default(0)
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt
  engine            BusinessEngine          @relation(fields: [engine_id], references: [id], onDelete: Cascade)
  tenant_operations TenantEngineOperation[]

  @@unique([engine_id, operation_key])
  @@index([engine_id, display_order])
  @@map("engine_operation_definitions")
}

/// Tenant activation and instruction snapshot. Disabling an engine leaves
/// connector and mapping configuration intact but removes it from AI runtime.
model TenantEngine {
  id                           String                  @id @default(uuid())
  company_id                   String
  engine_id                    String
  enabled                      Boolean                 @default(false)
  instruction_enabled          Boolean                 @default(true)
  default_instruction_snapshot String                  @db.Text
  /// Scheduling cut-off rules for this engine (src/scheduling-rules.js). Off unless enabled. Added 2026-10-20.
  scheduling_rules             Json                    @default("{}")
  /// After-service follow-up: completion check + survey frequency per topic (src/feedback.js). Added 2026-10-20.
  feedback_rules               Json                    @default("{}")
  tenant_instruction           String?                 @db.Text
  catalog_version              Int                     @default(1)
  enabled_at                   DateTime?
  updated_by                   String?
  created_at                   DateTime                @default(now())
  updated_at                   DateTime                @updatedAt
  company                      Company                 @relation(fields: [company_id], references: [id], onDelete: Cascade)
  engine                       BusinessEngine          @relation(fields: [engine_id], references: [id], onDelete: Restrict)
  fields                       TenantEngineField[]
  operations                   TenantEngineOperation[]

  @@unique([company_id, engine_id])
  @@index([company_id, enabled])
  @@map("tenant_engines")
}

model TenantEngineField {
  id               String       @id @default(uuid())
  company_id       String
  tenant_engine_id String
  definition_id    String?
  field_key        String
  label            String
  description      String?
  data_type        String       @default("string")
  enabled          Boolean      @default(true)
  required         Boolean      @default(false)
  is_custom        Boolean      @default(false)
  external_field   String?
  display_order    Int          @default(0)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  company          Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  tenant_engine    TenantEngine @relation(fields: [tenant_engine_id], references: [id], onDelete: Cascade)

  @@unique([tenant_engine_id, field_key])
  @@index([company_id, tenant_engine_id])
  @@map("tenant_engine_fields")
}

model TenantEngineOperation {
  id                      String                     @id @default(uuid())
  company_id              String
  tenant_engine_id        String
  operation_definition_id String
  enabled                 Boolean                    @default(true)
  policy                  String
  fallback_policy         String                     @default("create_human_task")
  created_at              DateTime                   @default(now())
  updated_at              DateTime                   @updatedAt
  company                 Company                    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  tenant_engine           TenantEngine               @relation(fields: [tenant_engine_id], references: [id], onDelete: Cascade)
  definition              EngineOperationDefinition  @relation(fields: [operation_definition_id], references: [id], onDelete: Restrict)
  mapping                 EngineOperationMapping?
  requests                BusinessOperationRequest[]
  capability_gap          CapabilityGap?

  @@unique([tenant_engine_id, operation_definition_id])
  @@index([company_id, enabled])
  @@map("tenant_engine_operations")
}

model EngineOperationMapping {
  id                         String                @id @default(uuid())
  company_id                 String
  tenant_engine_operation_id String                @unique
  integration_action_id      String
  field_mapping              Json                  @default("{}")
  response_mapping           Json?                 @default("{}")
  /// Integration blueprint (value labels, field notes, steps, derived fields,
  /// anchors). See docs/MASTERPLAN-integration-blueprints.md.
  workflow_config            Json                  @default("{}")
  status                     String                @default("mapped")
  created_at                 DateTime              @default(now())
  updated_at                 DateTime              @updatedAt
  company                    Company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  tenant_operation           TenantEngineOperation @relation(fields: [tenant_engine_operation_id], references: [id], onDelete: Cascade)
  integration_action         IntegrationAction     @relation(fields: [integration_action_id], references: [id], onDelete: Restrict)

  @@index([company_id, status])
  @@index([integration_action_id])
  @@map("engine_operation_mappings")
}

/// Logical operation history. External HTTP facts remain in
/// integration_executions; this table also represents unmapped fallbacks.
model BusinessOperationRequest {
  id                         String                @id @default(uuid())
  company_id                 String
  tenant_engine_operation_id String
  conversation_id            String?
  integration_execution_id   String?
  status                     String
  policy                     String
  requested_arguments        Json
  result                     Json?
  error_message              String?
  fallback_used              String?
  requested_by               String?
  /// Cases (2026-10-20): one open case per customer need. need_key = tenant job + the job's case keys
  /// (Marga: customer, branch, machine, category). followups = history of customer follow-ups and
  /// replaced attempts. replaced_by_id = the newer case that replaced this one (status "replaced").
  /// last_alert_at = last staff alert for this case (URGENT throttle: one per 15 minutes).
  need_key                   String?
  followups                  Json                  @default("[]")
  replaced_by_id             String?
  last_alert_at              DateTime?
  /// Case lifecycle (no expiry): waiting (no reference yet) | ticket_open (reference, not done) |
  /// done | cancelled | closed (by staff) | merged (added to another case). reference = tenant ticket no.
  case_status                String?
  reference                  String?
  closed_at                  DateTime?
  approved_by                String?
  approved_at                DateTime?
  completed_at               DateTime?
  created_at                 DateTime              @default(now())
  updated_at                 DateTime              @updatedAt
  company                    Company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  tenant_operation           TenantEngineOperation @relation(fields: [tenant_engine_operation_id], references: [id], onDelete: Restrict)

  @@index([company_id, status])
  @@index([company_id, created_at])
  @@index([conversation_id, status])
  @@index([company_id, need_key, status])
  @@index([company_id, case_status])
  @@index([conversation_id, case_status])
  @@index([integration_execution_id])
  @@map("business_operation_requests")
}

model CapabilityGap {
  id                         String                @id @default(uuid())
  company_id                 String
  tenant_engine_operation_id String                @unique
  operation_key              String
  frequency_count            Int                   @default(1)
  last_request_context       Json?
  fallback_used              String?
  first_seen_at              DateTime              @default(now())
  last_seen_at               DateTime              @default(now())
  company                    Company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  tenant_operation           TenantEngineOperation @relation(fields: [tenant_engine_operation_id], references: [id], onDelete: Cascade)

  @@index([company_id, frequency_count])
  @@map("capability_gaps")
}

/// Append-only tenant configuration history. Secret values are never placed
/// in metadata; callers must pass only masked and non-sensitive facts.
model TenantAuditLog {
  id          String   @id @default(uuid())
  company_id  String
  actor_id    String?
  actor_email String?
  action      String
  target_type String
  target_id   String?
  metadata    Json?
  created_at  DateTime @default(now())
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id, created_at])
  @@index([company_id, action])
  @@map("tenant_audit_logs")
}

/// Append-only execution and approval history for tenant custom actions.
model IntegrationExecution {
  id                  String                @id @default(uuid())
  company_id          String
  connection_id       String
  action_id           String
  conversation_id     String?
  status              String
  approval_policy     String
  requested_arguments Json
  result              Json?
  error_message       String?
  requested_by        String?
  approved_by         String?
  approved_at         DateTime?
  started_at          DateTime?
  completed_at        DateTime?
  created_at          DateTime              @default(now())
  company             Company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  connection          IntegrationConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  action              IntegrationAction     @relation(fields: [action_id], references: [id], onDelete: Cascade)

  @@index([company_id, created_at])
  @@index([company_id, status])
  @@index([conversation_id, status])
  @@map("integration_executions")
}

/// A record of AIStaff staff entering a customer's workspace to help.
///
/// Added 2026-08-19 with /platform. Staff reading a tenant's conversations is a
/// real intrusion — those threads contain the tenant's own customers' messages,
/// phone numbers and buying intent. The audit trail is what makes assisting
/// defensible: who entered, whose workspace, when, and why.
///
/// Written on ENTRY, not on exit, so an abandoned session is still recorded.
model AssistSession {
  id            String    @id @default(uuid())
  /// The AIStaff user doing the assisting.
  staff_user_id String
  staff_email   String
  /// The tenant being assisted.
  company_id    String
  company_name  String
  reason        String?
  started_at    DateTime  @default(now())
  ended_at      DateTime?

  @@index([company_id, started_at])
  @@index([staff_user_id, started_at])
  @@map("assist_sessions")
}

/// A one-time handoff link that lets a client authorize their own Facebook
/// Page without sharing a Facebook password or giving support remote control.
/// Only the SHA-256 hash is stored; the raw token exists solely in the link.
model FacebookConnectionInvite {
  id                  String    @id @default(uuid())
  company_id          String
  company_name        String
  token_hash          String    @unique
  created_by_user_id  String
  created_by_email    String
  expires_at          DateTime
  used_at             DateTime?
  revoked_at          DateTime?
  connected_page_id   String?
  connected_page_name String?
  created_at          DateTime  @default(now())

  @@index([company_id, created_at])
  @@index([expires_at])
  @@map("facebook_connection_invites")
}

/// A question a real customer asked that Closer could not answer.
///
/// Added 2026-08-18. This is the mechanism behind ongoing improvement support:
/// real unanswered customer questions turn into specific knowledge-base work
/// without anyone remembering to manually track them.
///
/// The FAQ step predicts what customers will ask. This records what they
/// ACTUALLY asked and got no answer to, which is better evidence: it is
/// specific to this business, ranked by real frequency, and it never stops
/// arriving. §6 calls this the highest-value feature nobody else builds.
///
/// Closer flags these itself — it already knows when it had to say it could
/// not confirm something, so no keyword matching or guesswork is involved.
model KnowledgeGap {
  id              String   @id @default(uuid())
  company_id      String
  /// The customer's question, in their own words.
  question        String
  /// Short label the model assigns, so near-identical questions group.
  topic           String
  conversation_id String?
  /// open | answered | dismissed
  status          String   @default("open")
  /// Incremented when the same topic comes up again — this is what ranks the
  /// list by what is actually costing sales.
  times_asked     Int      @default(1)
  last_asked_at   DateTime @default(now())
  created_at      DateTime @default(now())
  company         Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id, status, times_asked])
  @@map("knowledge_gaps")
}

/// Which model runs which function. Editable in AI Studio, no deploy needed.
///
/// Added 2026-08-18. Model choices were scattered across .env and code
/// defaults and had already drifted — GEMINI_MODEL still said
/// "gemini-1.5-flash", which is what a provider switch would silently have
/// used. Nobody chose that; it was just never updated.
///
/// Same reasoning as PromptRevision: the things that decide how Closer behaves
/// belong somewhere a human can see and change, not buried in code.
model ModelSetting {
  /// Function key, e.g. "closer_reply", "upload_relevance", "vision_extract".
  fn         String   @id
  provider   String
  model      String
  /// Free text so a new model can be added without a migration.
  note       String?
  updated_by String?
  updated_at DateTime @updatedAt

  @@map("model_settings")
}

/// A versioned, human-editable instruction block for an agent.
///
/// Added 2026-08-18. Closer's operating instructions used to live as string
/// literals inside buildGuardrailPrompt() — invisible to the person running the
/// business, unchangeable without a deploy, and with no record of what changed
/// or when. That is the same "hardcoded copy" mistake this codebase forbids
/// everywhere else, applied to the most important text in the product.
///
/// Every save writes a NEW ROW rather than overwriting: the history is the
/// point. When a reply goes wrong you need to know which instructions were live
/// at the time, and be able to put the previous set back immediately.
///
/// Rollback flips `is_active` to an earlier revision rather than copying its
/// text forward, so the log stays an honest record of what was actually run.
///
/// This holds INSTRUCTIONS ONLY. Company name, knowledge base, lead state and
/// the customer's message are assembled in code around it — so an edit here can
/// change behaviour but can never break variable substitution.
model PromptRevision {
  id         String   @id @default(uuid())
  /// Which instruction block. "closer_system" is the Messenger reply prompt.
  key        String
  version    Int
  content    String   @db.Text
  /// Why this change was made — shown in the revision list.
  note       String?
  /// Email of whoever saved it. Null for the seeded original.
  created_by String?
  is_active  Boolean  @default(false)
  created_at DateTime @default(now())

  @@unique([key, version])
  @@index([key, is_active])
  @@map("prompt_revisions")
}

/// One unit of business knowledge the agent may answer from.
///
/// Was Q&A-only. Widened 2026-08-17 for the intake wizard: a sales agent needs
/// price lists, promos, policies, shipping tables and media, which are not
/// questions. Nothing was renamed or dropped — existing rows are kind="qa" and
/// behave exactly as before.
///
/// RULE 2 (docs/handoff-masterplan.md): every field here is a FACT. Never store
/// a sentence for the agent to recite. The model writes the words at reply time.
model KnowledgeBase {
  id            String    @id @default(uuid())
  company_id    String
  category      String
  /// qa | prose | pricelist | promo | policy | shipping | media | instruction
  /// Controls how buildGuardrailPrompt renders the row. Unknown kinds fall
  /// back to prose rendering rather than being dropped.
  kind          String    @default("qa")
  /// Human label for non-Q&A rows ("Mission and vision", "Shipping rates").
  /// A price list is not a question and must not be forced into one.
  title         String?
  /// Only kind="qa" rows have a question. Nullable since 2026-08-17.
  question      String?
  answer        String
  /// Structured rows for tabular kinds: shipping rates by area, spec tables,
  /// price rows. Prose in a prompt makes the model do lookup and arithmetic in
  /// a paragraph; rows let it read one line. Shape: [{label, value, note}].
  data          Json?
  media         Json? // [{type: "video"|"image"|"pdf", url, caption}] — lets the agent send actual files when asked, not just describe them
  /// NULL = no expiry, which is the common case and the wizard default outside
  /// the promo step. Set for anything dated. Promos auto-deactivate on expiry;
  /// prices and policies only flag for review — see src/knowledge-base.js.
  valid_until   DateTime?
  /// Where this came from, so the wizard can show its source ("from
  /// pricelist-aug.xlsx"). A suggestion with no source must never be stored:
  /// an invented fact served for months is §9's phantom pricing at scale.
  source_name   String?
  /// upload | facebook_page | website | typed — how we obtained it.
  source_kind   String?
  /// ISO code for any amounts in this row. DemoSession learned this the hard
  /// way: "100" read off a US store and quoted as ₱100 is a number the
  /// business gets held to.
  currency      String?
  /// TRUE by default on purpose. Anything a human typed or saved is confirmed
  /// by that act, and defaulting false would have silently dropped the 6
  /// existing rows out of the prompt on migration. Only the AI-suggestion path
  /// writes false, and unconfirmed rows never reach the agent.
  confirmed     Boolean   @default(true)
  display_order Int       @default(0)
  tags          String[]  @default([])
  active        Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  company       Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id, active, kind])
  @@map("knowledge_base")
}

