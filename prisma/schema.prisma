/// A reusable, Meta-approved Utility Message template owned by one Page.
///
/// The neutral `key` is stable across industries; businesses can call the
/// assigned person a technician, driver, adviser, clinician, or any other
/// role inside the template variables without changing the workflow.
model CustomerUpdateTemplate {
  id                   String                   @id @default(uuid())
  company_id           String
  facebook_page_id     String
  key                  String
  version              Int                      @default(1)
  display_name         String
  description          String?                  @db.Text
  ai_usage_instruction String                   @db.Text
  meta_template_name   String
  language             String                   @default("en_US")
  body_text            String                   @db.Text
  variable_keys        String[]                 @default([])
  variable_examples    Json                     @default("{}")
  status               String                   @default("DRAFT")
  active               Boolean                  @default(true)
  meta_template_id     String?
  meta_error           String?                  @db.Text
  archived_at          DateTime?
  created_by_email     String?
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt
  company              Company                  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  facebook_page        FacebookPage             @relation(fields: [facebook_page_id], references: [id], onDelete: Cascade)
  deliveries           CustomerUpdateDelivery[]

  @@unique([company_id, facebook_page_id, key, version])
  @@unique([facebook_page_id, meta_template_name])
  @@index([company_id, active, status])
  @@index([company_id, facebook_page_id, key, version])
  @@map("customer_update_templates")
}

/// Append-only delivery audit for every attempted Customer Update.
///
/// `variables` and `rendered_text` are snapshots of what staff confirmed.
/// A unique idempotency key prevents a double-click from sending twice.
model CustomerUpdateDelivery {
  id               String                 @id @default(uuid())
  company_id       String
  facebook_page_id String
  conversation_id  String
  template_id      String
  status           String                 @default("sending")
  recipient_name   String?
  recipient_psid   String
  variables        Json
  rendered_text    String                 @db.Text
  meta_message_id  String?
  meta_error       String?                @db.Text
  idempotency_key  String                 @unique
  created_by_email String?
  created_at       DateTime               @default(now())
  sent_at          DateTime?
  company          Company                @relation(fields: [company_id], references: [id], onDelete: Cascade)
  facebook_page    FacebookPage           @relation(fields: [facebook_page_id], references: [id], onDelete: Restrict)
  conversation     Conversation           @relation(fields: [conversation_id], references: [id], onDelete: Restrict)
  template         CustomerUpdateTemplate @relation(fields: [template_id], references: [id], onDelete: Restrict)

  @@index([company_id, created_at])
  @@index([conversation_id, created_at])
  @@index([status, created_at])
  @@map("customer_update_deliveries")
}

