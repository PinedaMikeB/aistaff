{
  "name": "ai-inbox-sales-assistant",
  "version": "0.1.0",
  "description": "Focused AI Inbox Sales Assistant MVP for Facebook Page Messenger inquiry-to-quotation workflows.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/**/*.test.js",
    "dev:stack": "bash scripts/start-stack.sh",
    "configure:webhook": "node scripts/configure-meta-webhook.js",
    "sync:page-token": "node scripts/sync-page-token.js",
    "create:client": "node scripts/create-client.js",
    "assign:superadmin": "node scripts/assign-superadmin.js",
    "brandee:import-static-templates": "node scripts/brandee-import-static-templates.js",
    "brandee:activate-imported-templates": "node scripts/brandee-activate-imported-templates.js",
    "start:live": "bash scripts/start-live.sh",
    "install:launchd": "bash scripts/install-aistaff-launchd.sh",
    "setup:dns": "bash scripts/setup-aistaff-click-dns.sh",
    "status:live": "bash scripts/status-aistaff-live.sh",
    "migrate:db:do": "bash scripts/migrate-aistaff-db-to-do.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "remotion:studio": "npm --prefix remotion run studio",
    "remotion:render": "npm --prefix remotion run render:all",
    "pitch": "node src/pitch/index.js",
    "pitch:test": "node --test test/pitch.test.js",
    "simulate:paid": "node scripts/simulate-payment.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "morgan": "^1.10.0",
    "motion": "^12.43.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.11",
    "pdfkit": "^0.19.1",
    "playwright": "^1.62.1",
    "prisma": "^5.22.0",
    "sharp": "^0.35.3",
    "sip": "^0.0.6",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  }
}
